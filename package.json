{
	"name": "@johnfmorton/favicon-generator-craftcms",
	"version": "0.1.2",
	"description": "Generate favicon assets, manifests, and HTML tags for Craft CMS + Vite projects",
	"type": "module",
	"bin": {
		"craft-favicon-generator": "./bin/craft-favicon-generator"
	},
	"exports": {
		".": "./src/generate.mjs"
	},
